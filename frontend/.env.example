# Copy to .env.local. Never commit real keys.
# Leave VITE_API_BASE empty in dev so requests go through the Vite proxy (DI2_API_PORT, default 8765).
# Set it to the Cloud Run backend URL for a split deployment.
VITE_API_BASE=
# Google Maps JS API key (restrict to HTTP referrers) + a vector Map ID with dark cloud styling.
# If empty, BasinMap falls back to a deck.gl-only basemap (works offline).
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
